{
    "name": "shokirjonmk/yii3-enterprise-platform",
    "type": "project",
    "description": "Yii3 Enterprise Platform by ShokirjonMK — reusable, secure, scalable foundation for corporate and government information systems",
    "license": "proprietary",
    "authors": [
        {
            "name": "ShokirjonMK",
            "homepage": "https://github.com/ShokirjonMK",
            "role": "Author, architect & maintainer"
        }
    ],
    "homepage": "https://github.com/ShokirjonMK/Yii3-Enterprise-Platform",
    "support": {
        "source": "https://github.com/ShokirjonMK/Yii3-Enterprise-Platform",
        "issues": "https://github.com/ShokirjonMK/Yii3-Enterprise-Platform/issues"
    },
    "keywords": [
        "yii3",
        "enterprise",
        "platform",
        "rbac",
        "sso",
        "oneid",
        "kafka",
        "postgresql"
    ],
    "require": {
        "php": "~8.3.0",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "dragonmantank/cron-expression": "^3.4",
        "firebase/php-jwt": "^7.2",
        "guzzlehttp/guzzle": "^7.9",
        "httpsoft/http-message": "^1.1.6",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",
        "minishlink/web-push": "^9.0",
        "mongodb/mongodb": "^2.1",
        "open-telemetry/exporter-otlp": "^1.2",
        "open-telemetry/sdk": "^1.9",
        "predis/predis": "^2.3",
        "promphp/prometheus_client_php": "^2.14",
        "psr/container": "^2.0.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "psr/simple-cache": "^3.0",
        "spomky-labs/otphp": "^11.3",
        "symfony/console": "^7.4.7",
        "symfony/mailer": "^7.4",
        "yiisoft/access": "^2.0",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/arrays": "^3.2",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/auth": "^3.3",
        "yiisoft/cache": "^3.2",
        "yiisoft/cache-redis": "^2.0",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/data": "^2.0",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.1",
        "yiisoft/db-migration": "^2.2",
        "yiisoft/db-mssql": "^2.0",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/db-oracle": "^2.0",
        "yiisoft/db-pgsql": "^2.0.1",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/files": "^2.1",
        "yiisoft/html": "^4",
        "yiisoft/http": "^1.3",
        "yiisoft/hydrator": "^1.6",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/json": "^1.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/mailer": "^6.1",
        "yiisoft/mailer-symfony": "^4.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/rbac": "^2.1.2",
        "yiisoft/rbac-db": "^2.1",
        "yiisoft/request-body-parser": "^1.2",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/security": "^1.2",
        "yiisoft/session": "^3.0.1",
        "yiisoft/strings": "^2.7",
        "yiisoft/translator": "^3.2",
        "yiisoft/translator-message-php": "^1.1",
        "yiisoft/user": "^2.3",
        "yiisoft/validator": "^2.6",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-event": "^2.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-middleware": "^1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1",
        "zircote/swagger-php": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "kwn/php-rdkafka-stubs": "^2.2 || ^3.0",
        "phpunit/phpunit": "^11.5.55",
        "rector/rector": "^2.3.9",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "vimeo/psalm": "^6.16.1",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii-gii": "dev-master#2578b1841777cd70803e4c5126fbb00d81af3f4d"
    },
    "suggest": {
        "ext-rdkafka": "Required for the Kafka messaging adapter (installed in the platform Docker image)",
        "ext-redis": "Optional native Redis driver; Predis is used by default"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "test": "phpunit",
        "psalm": "psalm --no-cache",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.36"
        },
        "allow-plugins": {
            "yiisoft/config": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
