<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test suites
    unit          pure PHP, no I/O
    integration   real PostgreSQL (platform_test) + Redis, via the DI container   (APP_ENV=test)
    api           REST API over HTTP against a running stack (E2E_BASE_URL)
    e2e           browser-like HTML flows over HTTP (cookies, CSRF, HTMX headers)
    security      security regression tests over HTTP (headers, CSRF, IDOR, injection, authz)
  See docs/TESTING.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory="runtime/.phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="api">
            <directory>tests/Api</directory>
        </testsuite>
        <testsuite name="e2e">
            <directory>tests/E2E</directory>
        </testsuite>
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="E2E_BASE_URL" value="http://nginx:8080" force="false"/>
    </php>
</phpunit>
