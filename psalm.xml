<?xml version="1.0"?>
<psalm
    errorLevel="3"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    ensureOverrideAttribute="false"
    strictBinaryOperands="false"
    cacheDirectory="./runtime/cache/psalm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src" />
        <file name="public/index.php" />
        <file name="yii" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- PHP view templates: variables are injected by the renderer ($h, $this, $csrf), psalm cannot see them -->
            <directory name="src/**/views" />
            <!-- Enterprise Gii code templates (variables come from the generator) -->
            <directory name="src/Platform/Gii/templates" />
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <!-- ext-rdkafka ships no stubs; generated by scripts/ci/rdkafka-stub.php -->
        <file name="stubs/rdkafka.phpstub" preloadClasses="true" />
    </stubs>
    <issueHandlers>
        <MixedAssignment errorLevel="suppress" />
        <RiskyTruthyFalsyComparison errorLevel="suppress" />
    </issueHandlers>
</psalm>
