# ------------------------------------------------------------------------------
# Yii3 Enterprise Platform — environment configuration (LOCAL DEVELOPMENT TEMPLATE)
#
#   cp .env.example .env      (or: ./scripts/platform.sh init  — generates random secrets)
#
# Production: never use a .env file. Inject variables from Kubernetes Secrets /
# GitLab protected variables / a secret manager. See docs/SECURITY.md.
# ------------------------------------------------------------------------------

APP_ENV=dev
APP_DEBUG=true
APP_NAME="Yii3 Enterprise Platform"
APP_URL=http://localhost:8080
APP_LOCALE=uz
# 64 hex chars; used for HMAC signing (bootstrap tokens, webhooks, encrypted settings key derivation)
APP_SECRET=__GENERATE__
# Comma-separated trusted proxy CIDRs (for X-Forwarded-*). Empty = trust none.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# ------------------------------------------------------------------ PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=platform
DB_USER=platform
DB_PASSWORD=__GENERATE__
# Optional read replicas: host:port,host:port   (empty = all reads go to primary)
DB_REPLICAS=
DB_SSLMODE=disable
# Web (PHP-FPM) keeps one persistent connection per worker (saves ~5 ms SCRAM handshake per request).
# Size max_connections / PgBouncer for pods x pm.max_children. CLI workers always use regular connections.
DB_PERSISTENT=true
DB_TEST_NAME=platform_test

# ------------------------------------------------------------------ Additional databases (docs/DATABASES.md)
# Named connections to any number of databases of any engine, used via DatabaseManager:
#   pgsql/postgres, mysql/mariadb, sqlite, sqlsrv/mssql, oci/oracle, mongodb(+srv), clickhouse(s)
# URL: <driver>://user:password@host:port/database?option=value  (readonly=1 -> read-only connection)
# ${VAR} inside a URL is replaced by that variable (URL-encoded). More connections: Admin -> Databases (superadmin).
# The dev containers below start with `./scripts/platform.sh up databases`.
# passwords of the dev containers (defined before the URLs that reference them)
EXTRA_DB_PASSWORD=__GENERATE__
MONGO_PASSWORD=__GENERATE__
CLICKHOUSE_PASSWORD=__GENERATE__
MARIADB_PASSWORD=__GENERATE__
DB_CONNECTIONS=analytics,archive,docs,events,shop
DB_CONN_ANALYTICS_URL=postgres://platform:${EXTRA_DB_PASSWORD}@postgres-analytics:5432/analytics
DB_CONN_ANALYTICS_DESCRIPTION=Second PostgreSQL server (reports)
DB_CONN_ARCHIVE_URL=postgres://platform:${EXTRA_DB_PASSWORD}@postgres-archive:5432/archive
DB_CONN_ARCHIVE_DESCRIPTION=Third PostgreSQL server (archive)
DB_CONN_DOCS_URL=mongodb://platform:${MONGO_PASSWORD}@mongo:27017/docs?authSource=admin
DB_CONN_DOCS_DESCRIPTION=MongoDB (documents)
DB_CONN_EVENTS_URL=clickhouse://platform:${CLICKHOUSE_PASSWORD}@clickhouse:8123/events
DB_CONN_EVENTS_DESCRIPTION=ClickHouse (analytics events)
DB_CONN_SHOP_URL=mysql://platform:${MARIADB_PASSWORD}@mariadb:3306/shop
DB_CONN_SHOP_DESCRIPTION=MariaDB (MySQL driver)

# ------------------------------------------------------------------ Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
REDIS_DB=0
# standalone | sentinel | cluster
REDIS_MODE=standalone
REDIS_SENTINELS=
REDIS_SENTINEL_SERVICE=mymaster
# Optional: REDIS_URL=rediss://user:password@host:6380/0 overrides the values above (rediss = TLS)
REDIS_USERNAME=
REDIS_TLS=false
REDIS_SENTINEL_PASSWORD=
REDIS_CONNECT_TIMEOUT=1.5
REDIS_READ_TIMEOUT=3
# PHP-FPM keeps one Redis socket per role/database per worker (no TCP + AUTH per request)
REDIS_PERSISTENT=true
# Cache role: separate, evictable instance (allkeys-lfu). Empty = cache shares the state instance above.
# Password defaults to REDIS_PASSWORD; REDIS_CACHE_URL / _PORT / _DB / _USERNAME / _TLS / _MODE / _SENTINELS also exist.
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_DEFAULT_TTL=86400

# ------------------------------------------------------------------ Kafka
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=yii3-platform
KAFKA_TOPIC_PREFIX=
# PLAINTEXT | SSL | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ------------------------------------------------------------------ Object storage (S3 API)
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=platform
S3_KEY=platform
S3_SECRET=__GENERATE__
S3_PATH_STYLE=true

# ------------------------------------------------------------------ Mail
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM=noreply@platform.local

# ------------------------------------------------------------------ Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=yii3-platform
# Set when the "monitoring" profile runs (./scripts/platform.sh up monitoring), or in Admin → System Settings → Observability
PROMETHEUS_URL=
ALERTMANAGER_URL=
METRICS_TOKEN=__GENERATE__
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# ------------------------------------------------------------------ Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ------------------------------------------------------------------ Local ports
HTTP_PORT=8080
PG_PORT=55432
MAILPIT_UI_PORT=8025

# ---- Two-factor providers (optional; can also be set in Admin → Authentication → Two-factor)
# EIMZO_SERVER_URL=http://e-imzo-server:8080
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
