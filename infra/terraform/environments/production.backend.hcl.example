# terraform init -backend-config=environments/production.backend.hcl
# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment (GitLab protected variables).
bucket       = "yep-terraform-state"
key          = "yep/production/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
