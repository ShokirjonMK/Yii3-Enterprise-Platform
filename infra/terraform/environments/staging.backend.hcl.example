# terraform init -backend-config=environments/staging.backend.hcl
# For a self-hosted S3-compatible state bucket also set the endpoint and skip_* options.
bucket                      = "yep-terraform-state"
key                         = "yep/staging/terraform.tfstate"
region                      = "us-east-1"
encrypt                     = true
use_lockfile                = true
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
endpoints = {
  s3 = "https://s3.staging.example.internal"
}
