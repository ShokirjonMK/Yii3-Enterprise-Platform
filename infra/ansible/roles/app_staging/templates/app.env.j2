# {{ ansible_managed }}
# Rendered from ansible-vault variables; file mode 0600, owned by root. Never commit a rendered copy.
APP_ENV=prod
APP_DEBUG=false
APP_URL={{ app_staging_url }}
APP_LOCALE={{ app_staging_locale }}
APP_SECRET={{ vault_app_secret }}
TRUSTED_PROXIES={{ app_staging_trusted_proxies }}

DB_HOST=postgres
DB_PORT=5432
DB_NAME=platform
DB_USER=platform
DB_PASSWORD={{ vault_db_password }}
DB_SSLMODE=disable

REDIS_MODE=standalone
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_redis_password }}

KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

S3_ENDPOINT={{ app_staging_s3_endpoint }}
S3_REGION={{ app_staging_s3_region }}
S3_BUCKET={{ app_staging_s3_bucket }}
S3_KEY={{ vault_s3_key }}
S3_SECRET={{ vault_s3_secret }}
S3_PATH_STYLE=true

MAILER_DSN={{ vault_mailer_dsn }}
MAIL_FROM={{ app_staging_mail_from }}

OTEL_ENABLED=false
METRICS_TOKEN={{ vault_metrics_token }}
